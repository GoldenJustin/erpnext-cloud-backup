 "fields": [
  {
   "fieldname": "section_cloud",
   "fieldtype": "Section Break",
   "label": "Cloud Backup"
  },
  {
   "fieldname": "remote",
   "fieldtype": "Data",
   "label": "rclone Remote",
   "in_list_view": 1,
   "description": "Remote name as in rclone.conf, e.g. <code>onedrive</code>."
  },
  {
   "fieldname": "remote_path",
   "fieldtype": "Data",
   "label": "Destination Folder",
   "description": "Folder inside the remote to write backups to, e.g. <code>ERPNextBackups</code>."
  },
  {
   "fieldname": "rclone_config",
   "fieldtype": "Data",
   "label": "rclone Config Path",
   "description": "Optional: path to a config file on the server (only for the rclone console)."
  },
  {
   "fieldname": "rclone_config_content",
   "fieldtype": "Small Text",
   "label": "Microsoft 365 Config (paste rclone.conf)",
   "description": "Paste the full rclone.conf here (run <code>rclone config show</code> on the Odoo server). The app reads your OneDrive/SharePoint connection straight from it \u2014 no rclone install needed."
  },
  {
   "fieldname": "tenant",
   "fieldtype": "Data",
   "label": "Tenant (optional)",
   "description": "Microsoft tenant for login. Leave blank for \"common\" (works for most setups)."
  },
  {
   "fieldname": "backup_every_hours",
   "fieldtype": "Int",
   "label": "Backup Every (hours)",
   "default": "24",
   "description": "Automatic backup interval. 0 = automatic backup off (manual only); 24 = daily; 12 = twice a day."
  },
  {
   "fieldname": "num_backups",
   "fieldtype": "Int",
   "label": "Backup Slots (keep last N)",
   "default": "3",
   "description": "Keep the latest N backup folders in the cloud; older folders are deleted. Each backup goes into its own timestamped folder."
  },
  {
   "fieldname": "section_contents",
   "fieldtype": "Section Break",
   "label": "Backup Contents"
  },
  {
   "fieldname": "include_database",
   "fieldtype": "Check",
   "label": "Database (SQL dump)",
   "default": "1"
  },
  {
   "fieldname": "include_files",
   "fieldtype": "Check",
   "label": "Public site files",
   "default": "1"
  },
  {
   "fieldname": "include_private_files",
   "fieldtype": "Check",
   "label": "Private files",
   "default": "1"
  },
  {
   "fieldname": "column_contents",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "include_site_config",
   "fieldtype": "Check",
   "label": "Site config",
   "default": "1"
  },
  {
   "fieldname": "include_apps",
   "fieldtype": "Check",
   "label": "App code (apps-src)",
   "default": "1"
  },
  {
   "fieldname": "section_email",
   "fieldtype": "Section Break",
   "label": "Email Notifications"
  },
  {
   "fieldname": "enable_email",
   "fieldtype": "Check",
   "label": "Send Email After Each Backup",
   "default": "1"
  },
  {
   "fieldname": "email_recipients",
   "fieldtype": "Small Text",
   "label": "Email Recipients",
   "description": "Who to notify \u2014 email addresses or ERPNext user names, comma- or newline-separated (a user's email is taken from their User profile). Uses the site's outgoing email account."
  },
  {
   "fieldname": "email_subject",
   "fieldtype": "Data",
   "label": "Email Subject",
   "default": "[{status}] ERPNext backup - {site} - {time}",
   "description": "Placeholders: {status}, {site}, {time}, {last_backup}, {last_upload}, {remote}, {files}."
  },
  {
   "fieldname": "email_message",
   "fieldtype": "Small Text",
   "label": "Email Message",
   "default": "ERPNext backup {status}.\n\nSite: {site}\nTime: {time}\nDestination: {remote}\nLast backup: {last_backup}\n\nFiles uploaded:\n{files}",
   "description": "Placeholders: same as the subject. Leave as-is to use the default detailed message."
  },
  {
   "fieldname": "section_status",
   "fieldtype": "Section Break",
   "label": "Status"
  },
  {
   "fieldname": "last_backup",
   "fieldtype": "Datetime",
   "label": "Last Backup",
   "read_only": 1
  },
  {
   "fieldname": "last_upload",
   "fieldtype": "Datetime",
   "label": "Last Upload",
   "read_only": 1
  },
  {
   "fieldname": "last_status",
   "fieldtype": "Small Text",
   "label": "Last Status",
   "read_only": 1
  },
  {
   "fieldname": "section_console",
   "fieldtype": "Section Break",
   "label": "rclone Console (optional)"
  },
  {
   "fieldname": "console_command",
   "fieldtype": "Code",
   "label": "Command",
   "options": "Shell",
   "description": "Optional rclone commands (only if rclone is installed on the server)."
  },
  {
   "fieldname": "console_output",
   "fieldtype": "Code",
   "label": "Output",
   "read_only": 1
  }
